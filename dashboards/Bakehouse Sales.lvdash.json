{
  "datasets": [
    {
      "name": "19491724",
      "displayName": "sales",
      "queryLines": [
        "-- Sales at transaction grain, joined to every dimension of the star schema.\r\n",
        "-- INNER JOINs are safe: every fact references a dimension row (unknown member -1).\r\n",
        "SELECT\r\n",
        "  f.transaction_id,\r\n",
        "  d.date,\r\n",
        "  d.year,\r\n",
        "  d.month,\r\n",
        "  d.month_name,\r\n",
        "  d.day_name,\r\n",
        "  d.is_weekend,\r\n",
        "  p.product_name,\r\n",
        "  fr.franchise_name,\r\n",
        "  fr.city          AS store_city,\r\n",
        "  fr.country       AS store_country,\r\n",
        "  fr.size          AS store_size,\r\n",
        "  c.city           AS customer_city,\r\n",
        "  c.country        AS customer_country,\r\n",
        "  f.payment_method,\r\n",
        "  f.quantity,\r\n",
        "  f.total_price\r\n",
        "FROM workspace.gold.fact_sales     f\r\n",
        "JOIN workspace.gold.dim_date       d  ON f.date_key      = d.date_key\r\n",
        "JOIN workspace.gold.dim_product    p  ON f.product_key   = p.product_key\r\n",
        "JOIN workspace.gold.dim_franchise  fr ON f.franchise_key = fr.franchise_key\r\n",
        "JOIN workspace.gold.dim_customer   c  ON f.customer_key  = c.customer_key"
      ],
      "columns": [
        {
          "displayName": "avg_ticket",
          "description": "",
          "expression": "SUM(total_price) / COUNT(DISTINCT transaction_id)"
        }
      ]
    },
    {
      "name": "7ccb066c",
      "displayName": "pipeline_runs",
      "queryLines": [
        "-- Pipeline observability: final status of every task run in the last 30 days\r\n",
        "SELECT\r\n",
        "  job_run_id,\r\n",
        "  task,\r\n",
        "  layer,\r\n",
        "  target_table,\r\n",
        "  status,\r\n",
        "  rows_read,\r\n",
        "  rows_written,\r\n",
        "  rows_rejected,\r\n",
        "  started_at,\r\n",
        "  finished_at,\r\n",
        "  timestampdiff(SECOND, started_at, finished_at) AS duration_seconds,\r\n",
        "  error_message\r\n",
        "FROM workspace.ops.v_pipeline_runs\r\n",
        "WHERE started_at >= current_timestamp() - INTERVAL 30 DAYS"
      ]
    },
    {
      "name": "1a3ca7bb",
      "displayName": "data_quality",
      "queryLines": [
        "-- Data quality: rejected or flagged records by rule and layer\r\n",
        "SELECT\r\n",
        "  layer,\r\n",
        "  target_table,\r\n",
        "  rule_name,\r\n",
        "  COUNT(*)         AS issues,\r\n",
        "  MAX(detected_at) AS last_detected_at\r\n",
        "FROM workspace.ops.data_quality_issues\r\n",
        "GROUP BY ALL"
      ]
    }
  ],
